# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=admin
DB_PASSWORD=devpassword

# Application Configuration
FLASK_ENV=development
FLASK_APP=app.py
DEBUG=True

# AWS Configuration
AWS_REGION=ap-south-1
AWS_PROFILE=default

# Monitoring
PROMETHEUS_ENABLED=true
CLOUDWATCH_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
